{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [ "ES2023" ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": false,
    "removeComments": false,
    "types": [ "node" ]
  },
  "include": [
    "deploy.ts",
    "eslint.config.ts"
  ]
}
