<Project Sdk="Microsoft.VisualStudio.JavaScript.Sdk/1.0.5984942">
  <PropertyGroup>
    <StartupCommand>npm run build</StartupCommand>
    <JavaScriptTestRoot>.\</JavaScriptTestRoot>
    <JavaScriptTestFramework>Jasmine</JavaScriptTestFramework>
    <!-- Allows the build (F6/Ctrl+Shift+B) command to execute npm run build -->
    <ShouldRunBuildScript>true</ShouldRunBuildScript>
    <BuildScript>build</BuildScript>
    <BaseIntermediateOutputPath>.tmp\obj\</BaseIntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="src\main.ts" />
    <Content Include="src\ui.ts" />
    <Content Include="src\scan.ts" />
    <Content Include="src\staff.ts" />
    <Content Include="src\store.ts" />
    <Content Include="src\config.ts" />
    <Content Include="deploy.js" />
    <Content Include="tsconfig.json" />
    <Content Include="package.json" />
    <Content Include="README.md" />
  </ItemGroup>
  <ItemGroup>
    <None Include=".github\workflows\develop-prerelease.yml" />
    <None Include=".github\workflows\release.yml" />
  </ItemGroup>
</Project>