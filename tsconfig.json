{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [ "ES2023" ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": false,
    "removeComments": false
  },
  "include": [
    "staff-manager.ts",
    "src/i18n/**/*.ts",
    "node_modules/@openrct2/types/openrct2.d.ts"
  ]
}
