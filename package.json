{
  "name": "staff-assigner",
  "version": "1.0.0",
  "description": "An OpenRCT2 plugin that automates park staff management (handymen, security, mascots, mechanics).",
  "main": "dist/staff-assigner.js",
  "license": "MIT",
  "author": "Johannes",
  "scripts": {
    "build": "tsc --noEmit && esbuild staff-assigner.ts --bundle --outfile=dist/staff-assigner.js --format=iife --target=es2017 && node deploy.js",
    "watch": "esbuild staff-assigner.ts --bundle --outfile=dist/staff-assigner.js --format=iife --target=es2017 --watch"
  },
  "devDependencies": {
    "@openrct2/types": "^0.5.4",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "openrct2-flexui": "^0.1.0-prerelease.0"
  }
}
