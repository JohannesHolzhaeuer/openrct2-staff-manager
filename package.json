{
  "name": "staff-manager",
  "version": "0.9.5",
  "description": "An OpenRCT2 plugin that automates park staff management (handymen, security, entertainers, mechanics).",
  "main": "dist/staff-manager.js",
  "type": "module",
  "license": "MIT",
  "author": "Johannes Holzhäuer",
  "scripts": {
    "build": "npm run lint && npm run test && npm run typecheck && esbuild src/main.ts --bundle --outfile=dist/staff-manager.js --format=iife --target=es2023 && node deploy.ts",
    "lint": "eslint .",
    "watch": "esbuild src/main.ts --bundle --outfile=dist/staff-manager.js --format=iife --target=es2023 --watch",
    "test": "vitest run --reporter=tap --no-color",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@openrct2/types": "^0.5.4",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.4.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "jiti": "^2.7.0",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "openrct2-flexui": "0.1.0-prerelease.22"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
