{
  "name": "staff-manager",
  "version": "0.13.0",
  "description": "An OpenRCT2 plugin that automates park staff management (handymen, security, entertainers, mechanics).",
  "main": "dist/staff-manager.js",
  "type": "module",
  "license": "MIT",
  "author": "Johannes Holzhäuer",
  "scripts": {
    "build": "npm run verify && npm run bundle && node deploy.ts",
    "verify": "npm run lint && npm run test && npm run typecheck",
    "dev": "npm run bundle && node deploy.ts",
    "bundle": "esbuild src/main.ts --bundle --outfile=dist/staff-manager.js --format=iife --target=es2023",
    "lint": "eslint .",
    "audit": "npm audit --audit-level=high",
    "watch": "esbuild src/main.ts --bundle --outfile=dist/staff-manager.js --format=iife --target=es2023 --watch",
    "test": "vitest run --reporter=tap --no-color",
    "coverage": "vitest run --coverage --no-color",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@openrct2/types": "^0.5.4",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^5.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "openrct2-flexui": "0.1.0-prerelease.22"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
